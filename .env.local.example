# Copy to .env.local and fill in the values below (not committed — .env* is gitignored).
# Both are optional independently: leave either unset and that integration is just skipped.

# Slack Incoming Webhook URL — Slack workspace > Admin > Apps > Incoming Webhooks > Add New Webhook
SLACK_WEBHOOK_URL=

# Google Apps Script Web App URL that appends a row to a Sheet — see README/setup notes for the script
SHEET_WEBHOOK_URL=
